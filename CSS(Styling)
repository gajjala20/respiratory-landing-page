/* styles.css */
body, html {
  margin: 0;
  padding: 0;
  font-family: sans-serif;
}

.navbar {
  position: fixed;
  top: 0;
  width: 100%;
  background: transparent;
  padding: 10px 20px;
  transition: background 0.3s ease;
  z-index: 1000;
}

.navbar.scrolled {
  background: #333;
}

nav ul {
  display: flex;
  list-style: none;
  justify-content: center;
}

nav ul li {
  margin: 0 15px;
}

nav ul li a {
  text-decoration: none;
  color: white;
  padding: 8px;
  transition: background 0.3s;
}

nav ul li a:hover {
  background-color: #555;
  border-radius: 5px;
}

section {
  padding: 100px;
  margin-top: 60px;
  height: 100vh;
}
